{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "composite": true,
    "declaration": true,
    "esModuleInterop": true,
    "incremental": true,
    "jsx": "react",
    "lib": ["DOM", "ES2018", "ES2020.Intl"],
    "module": "esnext",
    // template-sync: keep
    // "bundler", not "node": @jupyterlab/lsp's declarations resolve
    // vscode-languageserver-protocol through that package's `exports` map,
    // which classic node resolution cannot read. Getting this right keeps
    // dependency .d.ts checking on, where skipLibCheck would silence it.
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "preserveWatchOutput": true,
    "resolveJsonModule": true,
    "outDir": "lib",
    "rootDir": "src",
    "strict": true,
    "strictNullChecks": true,
    "target": "ES2018",
    "types": ["jest"]
  },
  "include": ["src/*"]
}
